# solana-pos backend configuration (copy to .env; never commit .env)

# Postgres
POS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos

# Session tokens
POS_JWT_SECRET=change-me-to-a-long-random-string

# Solana network: devnet for development, mainnet-beta for production.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC mint. Devnet test mint below; PRODUCTION mainnet-beta USDC is
# EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v (verify before deploying).
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Shop revenue wallet that receives subscription payments. REQUIRED.
PAYMENT_RECIPIENT=REPLACE_WITH_YOUR_WALLET_ADDRESS

# Domain bound into the wallet sign-in message (replay protection).
POS_DOMAIN=localhost

# Subscription lifecycle (days / seconds).
NONCE_TTL_SECS=300
GRACE_DAYS=30
RECOVERY_DAYS=7

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2, S3-compatible) - optional.
# Omit the whole block to run without object storage; setting only part of it
# is a startup error. Never commit real credentials.
# R2_ENDPOINT_URL wins over R2_ACCOUNT_ID if both are set.
# ---------------------------------------------------------------------------
# R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Adapter-level upload cap in bytes (default 10 MiB).
R2_MAX_UPLOAD_BYTES=10485760
